NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://cvt-bearings.vercel.app
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Payload CMS — public origin/tenant plus the server-only webhook secret.
NEXT_PUBLIC_PAYLOAD_URL=https://payload.gmfb.co.nz
PAYLOAD_TENANT_SLUG=cvt-bearings
PAYLOAD_REVALIDATION_SECRET=replace_with_the_payload_webhook_secret

# Existing server-only credential for scoped order RPCs. The Payload webhook
# temporarily accepts this as a fallback during environment migration.
REVALIDATION_SECRET=replace_with_the_existing_order_rpc_secret

# Cloudflare R2 — server-only values used for authenticated review media uploads.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=cvt-bearings-reviews
R2_PUBLIC_BASE_URL=https://media.example.com

# Resend — server-only values for contact, quote and newsletter enquiries.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=CVT Bearings <enquiries@weblaunch.co.nz>
BUSINESS_ENQUIRY_EMAIL=info@cvt.co.nz

# Stripe — server-only credentials. Prefer a restricted key for production.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Active inclusive 15% NZ GST tax rate and the approved NZ delivery rate from Stripe.
STRIPE_NZ_GST_TAX_RATE_ID=txr_replace_me
STRIPE_NZ_SHIPPING_RATE_ID=shr_replace_me
